// ============================================================================
// PHONE THEME
// ============================================================================
// Controls how the site looks on phones (screens 639px wide and narrower).
// Computers and tablets have their own file: theme-desktop.jsonc.
//
// HOW TO EDIT (read once):
//  - Only change the value on the right of the colon. Leave the name on the left alone.
//  - Keep the quote marks "like this" where they are. Numbers have no quotes.
//  - Sizes need a unit: "14px". Colours are hex codes: "#F3F2EE".
//  - Bigger number = bigger / more space. Negative numbers move things the other way.
//  - Lines starting with // are notes for you. They do nothing.
//  - If you make a mistake, the build says exactly which line, and the live site stays as it was.
//  - Want to undo everything? Delete a line and it goes back to its original look.
// ============================================================================
{

  // ──────────────────────────────────────────────────────────────────────
  // FONTS
  // Which font each kind of text uses. Only the 3 installed fonts: Finlandica Text, Questrial, Plus Jakarta Sans.
  // ──────────────────────────────────────────────────────────────────────
  "fonts": {
    "heading": "Questrial",                                    // Big titles and numbers   [choose: Finlandica Text / Questrial / Plus Jakarta Sans]
    "body": "Finlandica Text",                                 // Paragraph text, form fields and buttons   [choose: Finlandica Text / Questrial / Plus Jakarta Sans]
    "label": "Finlandica Text",                                // Small capital labels, tabs, category tags, back link   [choose: Finlandica Text / Questrial / Plus Jakarta Sans]
    "menu": "Questrial"                                        // The burger menu links   [choose: Finlandica Text / Questrial / Plus Jakarta Sans]
  },

  // ──────────────────────────────────────────────────────────────────────
  // COLOURS (whole phone site)
  // The main colours.
  // ──────────────────────────────────────────────────────────────────────
  "colors": {
    "page": "#F3F2EE",                                         // Page background
    "text": "#1E1E1C",                                         // Main dark text
    "titleBand": "#EDECE6",                                    // Tinted band behind page titles and the home hero
    "titleBandSheenColor": "#DDDDD2",                          // Colour of the soft radial shade on that band
    "titleBandSheen": 0.09,                                    // Its strength (0 = flat)
    "titleBandSheenSize": "62%",                               // Its size
    "titleBandSheenX": "16%",                                  // Its centre, left (0%) to right (100%)
    "titleBandSheenY": "60%",                                  // Its centre, top (0%) to bottom (100%)
    "titleBandShadowColor": "#1A1A18",                         // Colour of the shadow the band casts below it
    "titleBandShadow": 0.09,                                   // Strength of that shadow
    "titleBandShadowBlur": "10px",                             // Softness of that shadow
    "titleBandShadowY": "6px",                                 // How far down it reaches
    "titleBandShadowSpread": "-6px",                           // Pulls it in from the sides
    "navy": "#253A79",                                         // Navy used on buttons, burger icon and menu
    "accent": "#254F99",                                       // Blue used for focus outlines and highlights
    "mutedText": "#807E78",                                    // Grey for .com / .si endings and small numbers
    "labelText": "#3A3938",                                    // Colour of small capital labels
    "selectionBackground": "#253A79",                          // Highlight colour when text is selected
    "selectionText": "#F9F8F6"                                 // Text colour inside the selection highlight
  },

  // ──────────────────────────────────────────────────────────────────────
  // HEADER + MENU
  // The top bar with the logo and the burger menu.
  // ──────────────────────────────────────────────────────────────────────
  "header": {
    "height": "87.5px",                                          // Height of the top bar
    "sidePadding": "20px",                                     // Space left of the logo and right of the burger
    "logoHeight": "50px",                                      // Logo size
    "logoX": "0px",                                            // Move logo right (+) or left (-)
    "logoY": "3px",                                            // Move logo down (+) or up (-)
    "shadowColor": "#373737",                                  // Colour of the soft shadow under the top bar (every page)
    "shadow": 0.115,                                           // Strength of that shadow
    "shadowBlur": "11px",                                      // Softness of that shadow
    "shadowY": "5px",                                          // How far down it reaches
    "shadowSpread": "-8px",                                    // Pulls it in from the sides (more negative = narrower)
    "burgerColor": "#253A79",                                  // Burger icon colour
    "menuBackground": "#F3F2EE",                               // Menu panel background
    "menuSize": "21px",                                        // Menu link text size
    "menuColor": "#253A79",                                    // Menu link colour
    "menuPressedColor": "#254F99",                             // Menu link colour while pressed
    "menuLinkPaddingY": "8px"                                  // Space above and below each menu link
  },

  // ──────────────────────────────────────────────────────────────────────
  // FOOTER
  // The black bar at the bottom.
  // ──────────────────────────────────────────────────────────────────────
  "footer": {
    "background": "#0D0D0D",                                   // Footer background
    "paddingTop": "17px",                                      // Space above the email
    "paddingBottom": "8px",                                    // Space below the © line
    "rowGap": ".4rem",                                         // Space between the email, tagline and © line
    "emailFont": "Plus Jakarta Sans",                          // Email font   [choose: Finlandica Text / Questrial / Plus Jakarta Sans]
    "emailSize": "14.5px",                                     // Email text size
    "emailColor": "#A49C8C",                                   // Email colour
    "emailHoverColor": "#485A7C",                              // Email colour while pressed
    "dividerLine": { "style": "dotted", "width": "1px", "color": "#625D54" }, // The dotted line under the email   [style: solid / dotted / dashed / none]
    "dividerGap": "11px",                                      // Space between email and that line
    "textFont": "Questrial",                                   // Font of the tagline and © line   [choose: Finlandica Text / Questrial / Plus Jakarta Sans]
    "taglineSize": "13px",                                     // Tagline text size
    "taglineColor1": "#8D8A82",                                // First tagline line
    "taglineColor2": "#848078",                                // Second tagline line
    "copyrightSize": "11.5px",                                 // © line text size
    "copyrightColor": "#848078"                                // © line colour
  },

  // ──────────────────────────────────────────────────────────────────────
  // PAGE TITLE BAND
  // The tinted band with the page title on the Gallery and Contact pages.
  // ──────────────────────────────────────────────────────────────────────
  "pageTitle": {
    "paddingY": "32px",                                        // Space above and below the title
    "paddingX": "20px",                                        // Space left and right of the title
    "size": "23px",                                            // Title size
    "weight": 600,                                             // Title boldness
    "lineHeight": 1.2,                                         // Title line spacing
    "color": "#1E1E1C",                                        // Title colour
    "line": { "style": "solid", "width": ".5px", "color": "rgba(113,112,112,.09)" } // Hairline under the band   [style: solid / dotted / dashed / none]
  },

  // ──────────────────────────────────────────────────────────────────────
  // HOME PAGE
  // Gaps are measured in pixels (px). Bigger number = more space.
  // ──────────────────────────────────────────────────────────────────────
  "landing": {
    "heroPaddingTop": "35px",                                  // Space above the headline
    "heroPaddingBottom": "50px",                               // Space under the button
    "heroPaddingX": "21px",                                    // Space left and right
    "heroBackground": "#F3F2EE",                               // Background colour of the hero (headline) section
    "heroSheenColor": "#DDDDD2",                               // Colour of the soft radial shade on the hero
    "heroSheen": 0.29,                                         // Its strength (0 = flat)
    "heroSheenSize": "77%",                                    // Its size
    "heroSheenX": "17%",                                       // Its centre, left (0%) to right (100%)
    "heroSheenY": "25%",                                       // Its centre, top (0%) to bottom (100%)
    "heroLine": { "style": "solid", "width": "0.5px", "color": "#CBCBC38F" },// Line between the hero and the domains band   [style: solid / dotted / dashed / none]
    "headlineSize": "46px",                                    // Headline size
    "headlineLineHeight": 1.2,                                 // Headline line spacing
    "headlineColor": "#1E1E1C",                                // Headline colour
    "introGap": "24px",                                        // Space between headline and paragraph
    "introSize": "18px",                                       // Paragraph text size
    "introColor": "#1E1E1C",                                   // Paragraph colour
    "buttonGap": "52px",                                       // Space between paragraph and button
    "buttonWidth": "190px",                                    // Button width
    "buttonHeight": "40px",                                    // Button height
    "buttonTextSize": "14px",                                  // Button text size
    "buttonTextColor": "#F3F2EE",                              // Button text colour
    "buttonFill": "#253A79",                                   // Button colour
    "buttonHoverFill": "#3A4E8C",                              // Button colour while pressed
    "buttonRadius": "5px",                                     // Button corner roundness
    "buttonSheen": 0.12,                                       // Strength of the light gradient on the button
    "buttonSheenAngle": 180,                                   // Its direction (180 = light from the top)
    "buttonEdge": 0.18,                                        // Thin highlight along its top edge
    "buttonGlow": 0.065,                                       // Strength of the glow under it (in the button colour)
    "buttonGlowBlur": "4px",                                   // Softness of that glow
    "buttonGlowY": "2px",                                      // How far below the button it sits
    "labelSize": "12.5px",                                     // Size of 'SELECTED DOMAINS' / 'ACQUIRING A DOMAIN'
    "labelSpacing": ".06em",                                   // Their letter spacing
    "marqueeBackground": "#EDECE6",                            // Background of the scrolling-logos band
    "marqueeSheenColor": "#D4D1C5E2",                          // Colour of the soft radial shade on the band (behind the cards)
    "marqueeSheen": 0.55,                                      // Its strength (0 = flat)
    "marqueeSheenSize": "101%",                                // Its size
    "marqueeSheenX": "38%",                                    // Its centre, left (0%) to right (100%)
    "marqueeSheenY": "7%",                                     // Its centre, top (0%) to bottom (100%)
    "marqueeShadowUp": 0.075,                                  // Strength of the band's shadow up into the hero
    "marqueeShadowDown": 0.06,                                 // Strength of the band's shadow down into the questions
    "marqueeLine": { "style": "solid", "width": "0.5px", "color": "#CBCBC38E" },// Line under the domains band   [style: solid / dotted / dashed / none]
    "marqueeShadowY": "9px",                                   // How far the band's shadow reaches up and down
    "marqueeShadowBlur": "29px",                               // How soft the shadow under the band is
    "marqueeShadowSpread": "-11px",                            // Shadow spread under the band (negative = narrower)
    "marqueeShadowColor": "#1A1A18",                           // Colour of the band's shadow
    "marqueePaddingTop": "27px",                               // Space above 'SELECTED DOMAINS'
    "marqueeLabelGap": "24px",                                 // Space between the label and the logos
    "marqueePaddingBottom": "30px",                            // Space under the logos
    "marqueeSideInset": "12px",                                // Space left and right of the scrolling area
    "marqueeFade": "36px",                                     // Width of the soft fade at both ends
    "marqueeFadeCurve": 0.75,                                  // How quickly cards appear inside the fade (low = stay hidden longer)
    "marqueeSeconds": 20,                                      // Seconds for one full scroll (bigger = slower)
    "marqueeLogoWidth": "164px",                               // Room each logo takes (width)
    "marqueeLogoHeight": "108px",                              // Room each logo takes (height)
    "marqueeItemGap": "5px",                                   // Space left and right of each card
    "marqueeCardBackground": "#F2F1ED",                        // Card colour behind each logo
    "marqueeCardBorder": { "style": "solid", "width": "0.5px", "color": "#D5D4D2D1" },// Card border (width 0px = none)   [style: solid / dotted / dashed / none]
    "marqueeCardRadius": "4px",                                // Card corner roundness
    "marqueeCardPaddingTop": "8px",                            // Space above the logo inside a card
    "marqueeCardPaddingX": "10px",                             // Space left and right of the logo inside a card
    "marqueeCardPaddingBottom": "4px",                         // Space under the domain name inside a card
    "marqueeCardShadowY": "2px",                               // How far the card shadow drops
    "marqueeCardShadowBlur": "10px",                           // How soft the card shadow is
    "marqueeCardShadowColor": "#1A1A1804",                     // Card shadow colour (the last 2 digits set its strength)
    "marqueeNameSize": "13px",                                 // Domain name text size
    "marqueeNameColor": "#4A4A45",                             // Domain name colour
    "marqueeExtColor": "#8C8B84",                              // Colour of .com / .si
    "faqPaddingTop": "55px",                                   // Space above 'ACQUIRING A DOMAIN'
    "faqBackground": "#F3F2EE",                                // Colour of the questions section
    "faqSheenColor": "#DDDDD2",                                // Colour of the soft radial shade on that section
    "faqSheen": 0.16,                                          // Its strength (0 = flat)
    "faqSheenSize": "120%",                                    // Its size
    "faqSheenX": "16%",                                        // Its centre, left (0%) to right (100%)
    "faqSheenY": "20%",                                        // Its centre, top (0%) to bottom (100%)
    "faqListGap": "26px",                                      // Space between that label and the first question
    "faqSideMargin": "12px",                                   // Space left and right of the questions
    "faqItemGap": "16px",                                      // Space between questions
    "faqQuestionSize": "10.5px",                               // Question text size
    "faqQuestionColor": "#1E1E1C",                             // Question colour
    "faqOpenFill": "#E6E5DDC9",                                // Background of the open question
    "faqOpenBorder": { "style": "solid", "width": "0.5px", "color": "#B3B2A8" },// Outline round the open question   [style: solid / dotted / dashed / none]
    "faqOpenColor": "#253A79",                                 // Colour the open question's title fades to
    "faqAnswerSize": "13px",                                   // Answer text size
    "faqAnswerLineHeight": 1.6,                                // Answer line spacing
    "faqAnswerColor": "#1E1E1C",                               // Answer colour
    "bottomSpace": "55px"                                     // Space under the last question, before the footer
  },

  // ──────────────────────────────────────────────────────────────────────
  // DOMAIN GALLERY PAGE
  // Per-domain logo size/position lives in content/gallery-phone.json. The 'master' settings move/scale ALL logos together.
  // ──────────────────────────────────────────────────────────────────────
  "gallery": {
    "tabsBackground": "#F8F7F4",                               // Background of the tab bar
    "tabsLine": { "style": "solid", "width": ".5px", "color": "rgba(70,70,70,.10)" }, // Hairline under the tab bar   [style: solid / dotted / dashed / none]
    "tabsPaddingTop": "16px",                                  // Space above the tabs
    "tabsPaddingBottom": "14px",                               // Space under the tabs
    "tabsGap": "22px",                                         // Space between tabs
    "tabSize": "10.5px",                                       // Tab text size
    "tabSpacing": ".12em",                                     // Space between letters of tabs
    "tabColor": "#8E8C85",                                     // Tab colour
    "tabActiveColor": "#253A79",                               // Selected tab colour
    "gridLine": { "style": "solid", "width": "1px", "color": "#DEDDD7" }, // Lines between gallery cells   [style: solid / dotted / dashed / none]
    "cellPadding": "10px",                                     // Space inside each cell, around the logo
    "cellPressedFill": "#FAF9F6",                              // Cell background while pressed
    "logoAreaPadding": "6% 10% 3%",                            // Space around the logo inside the cell: top, left+right, bottom
    "masterLogoScale": 1.08,                                      // MASTER: resize ALL gallery logos at once (1 = as set per domain, 1.1 = 10% bigger)
    "masterLogoX": "0%",                                       // MASTER: move ALL gallery logos right (+) or left (-)
    "masterLogoY": "0%",                                       // MASTER: move ALL gallery logos down (+) or up (-)
    "nameSize": "13.5px",                                      // Domain name text size
    "namePadding": "8px 1px 14px",                             // Space around the name: top, sides, bottom
    "nameColor": "#1A1A18",                                    // Domain name colour
    "extColor": "#807E78",                                     // Colour of .com / .si
    "dimmedLogoOpacity": 0.14,                                 // How faded non-matching logos get when filtering
    "dimmedNameOpacity": 0.28,                                 // How faded non-matching names get when filtering
    "backToTopColor": "#8E8C85"                                // 'Back to top' colour
  },

  // ──────────────────────────────────────────────────────────────────────
  // DOMAIN PAGES
  // Every individual domain page on the phone.
  // ──────────────────────────────────────────────────────────────────────
  "domain": {
    "namePaddingTop": "30px",                                  // Space above the domain name
    "namePaddingBottom": "22px",                               // Space under the domain name
    "namePaddingX": "40px",                                    // Space left and right of the name
    "nameLine": { "style": "solid", "width": ".5px", "color": "rgba(113,112,112,.09)" }, // Hairline under the name band   [style: solid / dotted / dashed / none]
    "nameSize": "23px",                                        // Domain name size
    "nameWeight": 600,                                         // Domain name boldness
    "nameColor": "#1E1E1C",                                    // Domain name colour
    "extColor": "#1E1E1C",                                     // Colour of .com / .si
    "viewerBackground": "#F8F7F4",                             // Background behind the logo viewer
    "viewerLine": { "style": "solid", "width": ".5px", "color": "rgba(70,70,70,.10)" }, // Hairline under the viewer   [style: solid / dotted / dashed / none]
    "viewerPaddingTop": "6px",                                 // Space above the viewer
    "viewerHeight": "186px",                                   // Height of the viewer
    "logoMaxHeight": "162px",                                  // Tallest a logo can be
    "logoSidePadding": "28px",                                 // Space left and right of a logo
    "logoScale": 1,                                            // MASTER: resize every logo in the viewer (1 = as set per domain)
    "logoX": "0%",                                             // MASTER: move every viewer logo right (+) or left (-)
    "logoY": "0%",                                             // MASTER: move every viewer logo down (+) or up (-)
    "logoLift": "21px",                                        // Lifts every viewer logo up by this much (evens the space above the logo and below the arrows)
    "arrowSize": "44px",                                       // Size of the arrow buttons' clickable area
    "arrowScale": 1,                                           // Size of the arrow icon itself (1 = normal)
    "arrowGap": "12px",                                        // Space between the two arrows
    "arrowY": "-48px",                                         // Move arrows down (+) or up (-)
    "arrowBottomSpace": "8px",                                 // Space under the arrows
    "arrowColor": "#192C60",                                   // Arrow colour
    "arrowDisabledColor": "#BDBDB2",                           // Arrow colour when it can't be used
    "viewerPaddingBottom": "36px",                             // Space between the viewer and the acquisition card
    "acquisitionSideMargin": "20px",                           // Space left and right of the acquisition card
    "acquisitionBackground": "#ECEBE5",                        // Acquisition card colour
    "acquisitionBorder": { "style": "solid", "width": "0.5px", "color": "#C6C6B7" },// Acquisition card outline   [style: solid / dotted / dashed / none]
    "acquisitionRadius": "4px",                                // Acquisition card corner roundness
    "acquisitionSheenColor": "#D2D2CCE2",                      // Colour of the soft radial shade on the card
    "acquisitionSheen": 0.45,                                  // Its strength (0 = flat)
    "acquisitionSheenSize": "132%",                            // Its size
    "acquisitionSheenX": "11%",                                // Its centre, left (0%) to right (100%)
    "acquisitionSheenY": "71%",                                // Its centre, top (0%) to bottom (100%)
    "acquisitionShadowColor": "#253A79",                       // Colour of the soft shadow under the card
    "acquisitionShadow": 0.08,                                 // Strength of that shadow
    "acquisitionShadowBlur": "25px",                           // Softness of that shadow
    "acquisitionShadowY": "3px",                               // How far down it sits
    "acquisitionShadowSpread": "-6px",                         // Pulls it in from the sides
    "acquisitionPaddingTop": "34px",                           // Space inside the card, above its label
    "acquisitionPaddingBottom": "26px",                        // Space inside the card, under the buttons
    "acquisitionPaddingX": "20px",                             // Space inside the card, left and right
    "acquisitionGap": "20px",                                  // Space between the label, sentence and form
    "acquisitionTextSize": "14px",                             // Text size of the sentence above the form
    "acquisitionTextLineHeight": 1.6,                          // Its line spacing
    "acquisitionTextColor": "#1E1E1C",                         // Its colour
    "brandWordColor": "#253A79",                               // Colour of the words Atom.com and Escrow.com in that sentence
    "acquisitionBottomSpace": "36px",                          // Space under the card
    "labelSize": "12px",                                       // Size of the 'AVAILABLE FOR ACQUISITION' / 'ABOUT THE DOMAIN' labels
    "labelSpacing": ".14em",                                   // Their letter spacing
    "fieldBoxFill": 0.42,                                      // Fill of the field boxes: see-through white over the card (0 = card colour, 1 = white)
    "fieldBoxBorder": { "style": "solid", "width": "0.5px", "color": "#D6D5CC" },// Outline of each field box   [style: solid / dotted / dashed / none]
    "fieldBoxRadius": "5px",                                   // Field box corner roundness
    "fieldBoxGap": "8px",                                      // Space between the field boxes
    "fieldBoxPaddingX": "14px",                                // Space between the box edge and the text
    "fieldBoxPaddingY": "11px",                                // Space above and below the text (box height)
    "fieldBoxGlowColor": "#6D6C64",                            // Colour of the soft glow around the boxes
    "fieldBoxGlow": 0.06,                                      // Strength of that glow
    "fieldBoxGlowBlur": "3px",                                 // Softness of that glow
    "fieldBoxFocusColor": "#253A79",                           // Box outline colour while typing
    "fieldBoxFocusGlow": 0.05,                                 // Glow strength while typing
    "inputSize": "16px",                                       // Text size inside fields
    "inputColor": "#1E1E1C",                                   // Text colour inside fields
    "placeholderColor": "#6A6962",                             // Colour of the hint text ('Name', 'Email', 'Message')
    "buttonsGap": "26px",                                      // Space between the fields and the buttons
    "buttonSpacing": "10px",                                   // Space between the two buttons
    "buttonHeight": "44px",                                    // Button height
    "buttonTextSize": "14px",                                  // Button text size
    "atomFill": "#253A79",                                     // 'View on Atom.com' button colour
    "atomHoverFill": "#3A4E8C",                                // 'View on Atom.com' colour while pressed
    "atomTextColor": "#F3F2EE",                                // 'View on Atom.com' text colour
    "atomSheen": 0.12,                                         // Strength of the light gradient on 'View on Atom.com'
    "atomSheenAngle": 180,                                     // Its direction (180 = light from the top)
    "atomEdge": 0.18,                                          // Thin highlight along its top edge
    "atomGlow": 0.09,                                          // Strength of the navy glow under it
    "buttonShadowBlur": "4px",                                 // Softness of the shadow under both buttons
    "buttonShadowY": "2px",                                    // How far below the buttons it sits
    "sendFill": "#D0CDC1",                                     // 'Send inquiry' button colour
    "sendHoverFill": "#3A4E8CCE",                              // 'Send inquiry' colour while pressed
    "sendTextColor": "#1A1A18",                                // 'Send inquiry' text colour
    "sendPressedTextColor": "#E9E8E7",                         // 'Send inquiry' text colour while pressed
    "sendBorder": { "style": "solid", "width": "0.5px", "color": "#B3B2A8" },// 'Send inquiry' outline   [style: solid / dotted / dashed / none]
    "sendSheenColor": "#FFFFFF",                               // Colour of the light gradient on 'Send inquiry'
    "sendSheen": 0.14,                                         // Its strength
    "sendSheenAngle": 180,                                     // Its direction (90 = from the left, 180 = from the top)
    "sendEdge": 0.23,                                          // Thin highlight along its top edge
    "sendShadowColor": "#727169",                              // Colour of the shadow under it
    "sendShadow": 0.06,                                        // Strength of that shadow
    "sendShadowBlur": "5px",                                   // Softness of that shadow
    "sendShadowY": "1px",                                      // How far below it sits
    "aboutSideMargin": "20px",                                 // Space left and right of the overview
    "aboutLine": { "style": "solid", "width": "1px", "color": "#E6E6E1" }, // Line above 'About the domain'   [style: solid / dotted / dashed / none]
    "aboutPaddingTop": "34px",                                 // Space above 'About the domain'
    "aboutPaddingBottom": "34px",                              // Space under the overview
    "aboutDivider": { "style": "dotted", "width": "1px", "color": "#D9D9D6AC" },// Dotted line under the overview, above 'More from the collection'   [style: solid / dotted / dashed / none]
    "aboutSize": "15px",                                       // Overview text size
    "aboutLineHeight": 1.6,                                    // Overview line spacing
    "aboutColor": "#1E1E1C",                                   // Overview colour
    "moreHeadPaddingTop": "34px",                              // Space between that dotted line and 'More from the collection'
    "moreHeadPaddingBottom": "20px",                           // Space under it
    "moreSize": "11px",                                        // 'More from the collection' text size
    "moreColor": "#3A3938",                                    // Its colour
    "relatedBackground": "#EDECE6",                            // Colour behind the related rows (same as the title band)
    "relatedSheenColor": "#DDDDD2",                            // Colour of the soft radial shade on the related rows
    "relatedSheen": 0.09,                                      // Its strength (0 = flat)
    "relatedSheenSize": "62%",                                 // Its size
    "relatedSheenX": "16%",                                    // Its centre, left (0%) to right (100%)
    "relatedSheenY": "60%",                                    // Its centre, top (0%) to bottom (100%)
    "overviewShadowColor": "#1C1C1BEE",                        // Colour of the soft shade rising from the related rows over the label
    "overviewShadow": 0.045,                                   // Its strength (0 = none)
    "overviewShadowReach": "22px",                             // How far up it reaches
    "relatedLine": { "style": "solid", "width": "1px", "color": "#E2E2DB" },// Lines between the related domains   [style: solid / dotted / dashed / none]
    "relatedTopLineColor": "#E2E2DB",                          // Colour of the line above the first related row
    "relatedLogoWidth": "106px",                               // Width of each related logo
    "relatedGap": "16px",                                      // Space between logo and name
    "relatedPressedFill": "#FAF9F6",                           // Row colour while pressed
    "relatedLogoScale": 1,                                     // MASTER: resize the 3 related logos (1 = as set in gallery-phone.json)
    "relatedLogoX": "0%",                                      // MASTER: move the 3 related logos right (+) or left (-)
    "relatedLogoY": "0%",                                      // MASTER: move the 3 related logos down (+) or up (-)
    "relatedNameSize": "14px",                                 // Related domain name text size
    "relatedNameColor": "#1A1A18",                             // Related domain name colour
    "relatedExtColor": "#807E78",                              // Colour of .com / .si
    "relatedChevronColor": "#9A9892"                           // Colour of the little arrow at the end of each row
  },

  // ──────────────────────────────────────────────────────────────────────
  // CONTACT PAGE
  // The inquiry form page on the phone.
  // ──────────────────────────────────────────────────────────────────────
  "contact": {
    "paddingTop": "34px",                                      // Space above the intro
    "paddingBottom": "56px",                                   // Space under the form
    "paddingX": "20px",                                        // Space left and right
    "introSize": "15px",                                       // Intro text size
    "introWeight": 400,                                        // Intro boldness
    "introLineHeight": 1.6,                                    // Intro line spacing
    "introColor": "#1E1E1C",                                   // Intro colour
    "introGap": "26px",                                        // Space between intro and form
    "inputSize": "16px",                                       // Text size inside fields
    "inputColor": "#1E1E1C",                                   // Text colour inside fields
    "placeholderColor": "#6A6962",                             // Colour of the hint text ('First name')
    "textareaHeight": "96px",                                  // Height of the message box
    "buttonGap": "20px",                                       // Space between the fields and the button
    "successTitleSize": "22px",                                // 'Message received' size
    "successTextSize": "15px",                                 // 'Thank you' text size
    "errorColor": "#8A2C1F"                                    // Colour of the error message
  }
}
