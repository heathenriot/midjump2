// ============================================================================
// DESKTOP + TABLET THEME
// ============================================================================
// Controls how the whole site looks on computers AND tablets (tablets use these exact settings).
// Phones have their own file: theme-phone.jsonc.
//
// HOW TO EDIT (read once):
//  - Only change the value on the right of the colon. Leave the name on the left alone.
//  - Keep the quote marks "like this" where they are. Numbers have no quotes.
//  - Sizes need a unit: "14px". Colours are hex codes: "#F3F2EE".
//  - Bigger number = bigger / more space. Negative numbers move things the other way.
//  - Lines starting with // are notes for you. They do nothing.
//  - If you make a mistake, the build says exactly which line, and the live site stays as it was.
//  - Want to undo everything? Delete a line and it goes back to its original look.
// ============================================================================
{

  // ──────────────────────────────────────────────────────────────────────
  // FONTS
  // Which font each kind of text uses. You can only pick the 3 installed fonts: Finlandica Text, Questrial, Plus Jakarta Sans.
  // ──────────────────────────────────────────────────────────────────────
  "fonts": {
    "heading": "Questrial",                                    // Big titles (e.g. 'Domain Collection', the home headline), the 01 02 03 numbers, and the 'Message received' note   [choose: Finlandica Text / Questrial / Plus Jakarta Sans]
    "body": "Finlandica Text",                                 // Paragraph text, form fields and buttons   [choose: Finlandica Text / Questrial / Plus Jakarta Sans]
    "label": "Finlandica Text"                                 // Small capital labels, gallery tabs, category tags, back links   [choose: Finlandica Text / Questrial / Plus Jakarta Sans]
  },

  // ──────────────────────────────────────────────────────────────────────
  // COLOURS (whole site)
  // The main colours used on every page.
  // ──────────────────────────────────────────────────────────────────────
  "colors": {
    "page": "#F3F2EE",                                         // Page background (the cream colour)
    "text": "#1A1A18",                                         // Main dark text colour (titles, names)
    "bodyText": "#1E1E1C",                                     // Paragraph text colour
    "mutedText": "#9A9892",                                    // Grey used for .com / .si endings and small numbers
    "accent": "#253A79",                                       // Blue used on hover and the nav underline
    "accentDark": "#253A79",                                   // Dark navy used for nav links and arrows
    "selectionBackground": "#253A79",                          // Highlight colour when text is selected
    "selectionText": "#F9F8F6"                                 // Text colour inside the selection highlight
  },

  // ──────────────────────────────────────────────────────────────────────
  // SMALL SECTION LABELS
  // The little spaced-out capital headings, like SELECTED DOMAINS, ACQUIRING A DOMAIN, AVAILABLE FOR ACQUISITION.
  // ──────────────────────────────────────────────────────────────────────
  "labels": {
    "size": "12px",                                            // Text size
    "spacing": ".14em",                                        // Space between letters
    "weight": 500,                                             // Boldness (300 light, 400 normal, 500 medium)
    "color": "#3A3938"                                         // Colour
  },

  // ──────────────────────────────────────────────────────────────────────
  // FRAME + LINES (whole site)
  // The width of the page column and the dotted lines. 'rail' = the two vertical side lines. 'divider' = horizontal lines under the header, titles and tabs. 'sectionDivider' = the lines under the hero/marquee/acquisition blocks.
  // ──────────────────────────────────────────────────────────────────────
  "frame": {
    "maxWidth": "760px",                                       // Widest the central column can get
    "sideMargin": "32px",                                      // Minimum space left and right of the column on small screens
    "rail": { "style": "dotted", "width": "1px", "color": "#B3B2A8" }, // The two vertical side lines of the column   [style: solid / dotted / dashed / none]
    "divider": { "style": "dotted", "width": "1px", "color": "#B3B2A8" }, // Horizontal lines under the header, page titles, tabs and above the footer   [style: solid / dotted / dashed / none]
    "sectionDivider": { "style": "dotted", "width": "1px", "color": "#C6C6B7" } // Horizontal lines under the home hero, marquee band, logo viewer and acquisition card   [style: solid / dotted / dashed / none]
  },

  // ──────────────────────────────────────────────────────────────────────
  // NAVBAR (every page)
  // The top bar: logo and links. The side menu is the small menu that floats beside the page on wide screens.
  // ──────────────────────────────────────────────────────────────────────
  "navbar": {
    "height": "100px",                                         // Height of the top bar
    "logoHeight": "98px",                                      // Size of the midjump logo (bigger number = bigger logo)
    "logoX": "0px",                                            // Move logo right (+) or left (-). Example: 10px or -10px
    "logoY": "14px",                                           // Move logo down (+) or up (-)
    "font": "Finlandica Text",                                 // Font of the links   [choose: Finlandica Text / Questrial / Plus Jakarta Sans]
    "linkSize": "12.25px",                                     // Link text size
    "linkWeight": 500,                                         // Link boldness (300 / 400 / 500)
    "linkSpacing": ".05em",                                    // Space between letters of links
    "linkCase": "uppercase",                                   // uppercase = CAPITALS, none = as typed   [choose: uppercase / none / capitalize]
    "linkGap": "32px",                                         // Space between the links
    "linkBottomSpace": "19px",                                 // Space under the links (moves them up/down)
    "linkColor": "#253A79",                                    // Link colour
    "linkHoverColor": "#3A4E8C",                               // Link colour on hover
    "underlineColor": "#253A79",                               // Colour of the sliding underline
    "underlineThickness": "2px",                               // Thickness of the sliding underline
    "sideLinkSize": "12.5px",                                  // Floating side menu: text size
    "sideLinkGap": "10px",                                     // Floating side menu: space between links
    "sideMarkSize": "26px"                                     // Floating side menu: size of the small logo mark
  },

  // ──────────────────────────────────────────────────────────────────────
  // FOOTER (every page)
  // The black bar at the bottom.
  // ──────────────────────────────────────────────────────────────────────
  "footer": {
    "background": "#0D0D0D",                                   // Footer background
    "paddingTop": "19px",                                      // Space above the email
    "paddingBottom": "12px",                                   // Space below the © line
    "rowGap": ".4rem",                                         // Space between the email, tagline and © line
    "emailFont": "Plus Jakarta Sans",                          // Email font   [choose: Finlandica Text / Questrial / Plus Jakarta Sans]
    "emailSize": "14.5px",                                     // Email text size
    "emailColor": "#A49C8C",                                   // Email colour
    "emailHoverColor": "#485A7C",                              // Email colour on hover
    "dividerWidth": "142px",                                   // Length of the dotted line under the email
    "dividerLine": { "style": "dotted", "width": "1px", "color": "#46433C" }, // Style of that dotted line   [style: solid / dotted / dashed / none]
    "dividerGap": "4px",                                       // Space between email and that line
    "textFont": "Questrial",                                   // Font of the tagline and © line   [choose: Finlandica Text / Questrial / Plus Jakarta Sans]
    "taglineSize": "14.5px",                                   // Tagline text size
    "taglineColor1": "#8D8A82",                                // First part of tagline ('Curated digital identities,')
    "taglineColor2": "#848078",                                // Second part of tagline ('secured through Escrow.com')
    "copyrightSize": "11.5px",                                 // © line text size
    "copyrightColor": "#848078"                                // © line colour
  },

  // ──────────────────────────────────────────────────────────────────────
  // HOME PAGE
  // Gaps are measured in pixels (px). Bigger number = more space.
  // ──────────────────────────────────────────────────────────────────────
  "landing": {
    "heroPaddingTop": "58px",                                  // Space above the headline
    "heroPaddingBottom": "76px",                               // Space under the button (before the marquee)
    "headlineSize": "56px",                                    // Headline text size
    "headlineLineHeight": 1.2,                                 // Headline line spacing (1 = tight, 1.5 = loose)
    "headlineColor": "#1A1A18",                                // Headline colour
    "introGap": "22px",                                        // Space between headline and the paragraph under it
    "introSize": "21px",                                       // Paragraph text size
    "introLineHeight": 1.22,                                   // Paragraph line spacing
    "introColor": "#1E1E1C",                                   // Paragraph colour
    "buttonGap": "50px",                                       // Space between the paragraph and the button
    "buttonWidth": "210px",                                    // Button width
    "buttonPaddingY": "7.5px",                                 // Button height (space above and below the text)
    "buttonTextSize": "15px",                                  // Button text size
    "buttonTextColor": "#1A1A18",                              // Button text colour
    "buttonFill": "#ECEBE5",                                   // Button background
    "buttonBorderColor": "#B3B2A8",                            // Button outline colour
    "buttonHoverBorderColor": "#ECEBE5",                       // Button outline colour on hover
    "buttonHoverChevronColor": "#253A79",                      // Colour of the button arrow on hover
    "buttonRadius": "4px",                                     // Button corner roundness
    "marqueeBackground": "#ECEBE5",                            // Background of the scrolling-logos band
    "marqueePaddingTop": "30px",                               // Space above 'SELECTED DOMAINS'
    "marqueeLabelGap": "44px",                                 // Space between 'SELECTED DOMAINS' and the logos
    "marqueePaddingBottom": "46px",                            // Space under the logos (before the band ends)
    "marqueeSideInset": "49px",                                // Space left and right of the scrolling area
    "marqueeFade": "64px",                                     // Width of the soft fade at both ends
    "marqueeSeconds": 45,                                      // Seconds for one full scroll (bigger = slower)
    "marqueeLogoWidth": "220px",                               // Room each logo takes (width)
    "marqueeLogoHeight": "164px",                              // Room each logo takes (height)
    "marqueeLogoPullUp": "-39px",                              // Pulls logos closer to the label above (more negative = closer)
    "marqueeLogoPullDown": "-29px",                            // Pulls domain names closer to the logos (more negative = closer)
    "marqueeNameGap": "8px",                                   // Space between a logo and its domain name
    "marqueeNameSize": "15px",                                 // Domain name text size
    "marqueeNameColor": "#1A1A18",                             // Domain name colour
    "marqueeExtColor": "#9A9892",                              // Colour of .com / .si
    "faqPaddingTop": "62px",                                   // Space above 'ACQUIRING A DOMAIN'
    "faqListGap": "36px",                                      // Space between that label and the first question
    "faqRule": { "style": "none", "width": "1px", "color": "#C6C6B7" }, // Lines between the questions (off by default)   [style: solid / dotted / dashed / none]
    "faqOpenFill": "#ECEBE5",                                  // Background of the open question and its answer
    "faqSidePadding": "20px",                                  // Space left of the numbers and right of the + / − icons
    "faqAnswerBottom": "26px",                                 // Space under an open answer
    "faqRowPaddingY": "14px",                                  // Space above and below each question
    "faqNumberWidth": "30px",                                  // Width of the 01 02 03 column (answers line up with the questions)
    "faqWidth": "602px",                                       // Width of the question list
    "faqQuestionSize": "12px",                                 // Question text size
    "faqQuestionSpacing": ".07em",                             // Space between letters of questions
    "faqOpenColor": "#253A79",                                 // Colour of the open question and its − icon
    "faqOpenNumberColor": "#1A1A18",                           // Colour of the number on the open question
    "faqIconSize": "28px",                                     // Size of the round + / − icon
    "faqIconOpenFill": "#F3F2EE",                              // Fill of the round icon when open
    "faqIconOpenBorder": "#ECEBE5",                            // Border of the round icon when open
    "faqQuestionColor": "#1E1E1C",                             // Question colour
    "faqNumberColor": "#9A9892",                               // Colour of 01 02 03
    "faqAnswerSize": "15px",                                   // Answer text size
    "faqAnswerLineHeight": 1.55,                               // Answer line spacing
    "faqAnswerColor": "#1E1E1C",                               // Answer colour
    "faqAnswerMaxWidth": "500px",                              // Widest an answer paragraph gets
    "bottomSpace": "66px"                                      // Smallest space under the last answer
  },

  // ──────────────────────────────────────────────────────────────────────
  // DOMAIN GALLERY PAGE
  // Per-domain logo size/position lives in content/gallery-desktop.json. The 'master' settings here move/scale ALL gallery logos together.
  // ──────────────────────────────────────────────────────────────────────
  "gallery": {
    "titleSize": "35px",                                       // Page title size ('Domain Collection')
    "titleWeight": 600,                                        // Page title boldness
    "titleColor": "#1A1A18",                                   // Page title colour
    "titlePaddingTop": "40px",                                 // Space above the title
    "titlePaddingBottom": "32px",                              // Space under the title
    "tabsPaddingTop": "25px",                                  // Space above the filter tabs
    "tabsPaddingBottom": "25px",                               // Space between the filter tabs and the first row of tiles
    "tabsGap": "30px",                                         // Space between tabs
    "tabSize": "11px",                                         // Tab text size
    "tabSpacing": ".12em",                                     // Space between letters of tabs
    "tabColor": "#555450",                                     // Tab colour
    "tabHoverColor": "#253A79",                                // Tab colour on hover
    "tabCountColor": "#9A9993",                                // Colour of the little numbers next to tabs
    "tabChevronColor": "#253A79",                              // Colour of the little arrow to the left of the selected tab
    "tabChevronSize": "4.5px",                                 // Size of that arrow
    "tabChevronGap": "8px",                                    // Space between that arrow and the tab name
    "trayBackground": "#ECEBE5",                               // The grey tray behind the tabs and tiles
    "traySheenColor": "#D2D2C3",                               // Colour of the soft radial shade across the tray
    "traySheenStrength": 0.3,                                  // Its strength (0 = none)
    "traySheenSize": "95%",                                    // Its size
    "traySheenX": "23%",                                       // Where its centre sits, left (0%) to right (100%)
    "traySheenY": "31%",                                       // Where its centre sits, top (0%) to bottom (100%)
    "traySidePadding": "18px",                                 // Space between the tray edges and the tiles
    "trayBottomPadding": "40px",                               // Space under the last row of tiles
    "tileGap": "14px",                                         // Space between tiles
    "tileBackground": "#F8F8F4",                               // Tile colour (also the related tiles on domain pages)
    "tileBorder": { "style": "solid", "width": "1px", "color": "#BDBDB4" }, // Tile outline   [style: solid / dotted / dashed / none]
    "tileRadius": "4px",                                       // Tile corner roundness
    "tileShadow": 0.015,                                       // Strength of the faint shadow under each tile (0 = flat)
    "tileHoverBackground": "#FAFAF8",                          // Tile colour on hover
    "tileHoverBorderColor": "#667292",                         // Tile outline colour on hover
    "tileHoverShadow": 0.05,                                   // Strength of the shadow under a tile on hover
    "cellPadding": "14px",                                     // Space inside each tile, around the logo
    "logoAreaPadding": "6% 12% 3%",                            // Space around the logo inside the cell: top, left+right, bottom
    "masterLogoScale": 1.04,                                      // MASTER: resize ALL gallery logos at once (1 = as set per domain, 1.1 = 10% bigger)
    "masterLogoX": "0%",                                       // MASTER: move ALL gallery logos right (+) or left (-)
    "masterLogoY": "0%",                                       // MASTER: move ALL gallery logos down (+) or up (-)
    "nameSize": "15px",                                        // Domain name text size
    "namePadding": "10px 1px 16px",                            // Space around the name: top, sides, bottom
    "nameColor": "#1A1A18",                                    // Domain name colour
    "extColor": "#9A9892",                                     // Colour of .com / .si
    "dimmedLogoOpacity": 0.14,                                 // How faded non-matching logos get when filtering (0 = invisible, 1 = not faded)
    "dimmedNameOpacity": 0.28                                  // How faded non-matching names get when filtering
  },

  // ──────────────────────────────────────────────────────────────────────
  // DOMAIN PAGES
  // Every individual domain page.
  // ──────────────────────────────────────────────────────────────────────
  "domain": {
    "nameSize": "35px",                                        // Domain name size at the top
    "nameWeight": 600,                                         // Domain name boldness
    "nameColor": "#1A1A18",                                    // Domain name colour
    "extColor": "#9A9892",                                     // Colour of .com / .si
    "namePaddingTop": "40px",                                  // Space above the domain name
    "namePaddingBottom": "32px",                               // Space under the domain name
    "viewerBackground": "#F6F5F2",                             // Background of the whole logo viewer band
    "viewerPaddingTop": "16px",                                // Space above the viewer
    "viewerPaddingBottom": "24px",                             // Space under the viewer arrows
    "viewerHeight": "185px",                                   // Height of the viewer (logos keep their size; the empty space around them is cropped)
    "viewerMaxWidth": "560px",                                 // Width of the viewer
    "firstLogoWidth": "360px",                                 // Widest the FIRST logo can be
    "firstLogoHeight": "230px",                                // Height of the FIRST logo
    "otherLogoWidth": "440px",                                 // Widest the other logos can be
    "otherLogoHeight": "229px",                                // Height of the other logos
    "logoScale": 1.01,                                         // MASTER: resize every logo in the viewer (1 = as set per domain)
    "logoX": "0%",                                             // MASTER: move every viewer logo right (+) or left (-)
    "logoY": "0%",                                             // MASTER: move every viewer logo down (+) or up (-)
    "viewerFadeWidth": "14%",                                  // Width of the soft fade at the viewer's edges
    "arrowSize": "44px",                                       // Size of the arrow buttons' clickable area
    "arrowScale": 1,                                           // Size of the arrow icon itself (1 = normal)
    "arrowGap": "16px",                                        // Space between the two arrows
    "arrowY": "0px",                                           // Move arrows down (+) or up (-)
    "arrowColor": "#253A79",                                   // Arrow colour
    "arrowHoverColor": "#3A4E8C",                              // Arrow colour on hover
    "arrowDisabledColor": "#BDBDB2",                           // Arrow colour when it can't be used
    "acquisitionBackground": "#ECEBE5",                        // Background of the 'Available for acquisition' block
    "acquisitionPaddingTop": "42px",                           // Space above its label
    "acquisitionPaddingBottom": "46px",                        // Space under its buttons
    "acquisitionTextSize": "16.5px",                           // Text size of the sentence above the form
    "acquisitionTextColor": "#1E1E1C",                         // Colour of that sentence
    "brandWordColor": "#253A79",                               // Colour of the words Atom.com and Escrow.com in that sentence
    "acquisitionNameWeight": 500,                              // Boldness of the domain name in that sentence (400 = regular, 500 = medium)
    "acquisitionNameColor": "#1A1A18",                         // Colour of the domain name in that sentence
    "fieldGap": "8px",                                         // Space between the form fields
    "fieldWidth": "505px",                                     // Width of the form fields
    "fieldBoxFill": 0.42,                                      // Fill of the field boxes: see-through white over the card (0 = card colour, 1 = white)
    "fieldBoxBorder": { "style": "solid", "width": "0.5px", "color": "#D6D5CC" },// Outline of each field box   [style: solid / dotted / dashed / none]
    "fieldBoxRadius": "5px",                                   // Field box corner roundness
    "fieldBoxGlowColor": "#6D6C64",                            // Colour of the soft glow around the field boxes
    "fieldBoxGlow": 0.06,                                      // Strength of that glow (0 = none)
    "fieldBoxGlowBlur": "3px",                                 // Softness of that glow
    "fieldBoxFocusColor": "#253A79",                           // Field box outline colour while typing
    "fieldBoxFocusGlow": 0.05,                                 // Glow strength while typing
    "inputSize": "14px",                                       // Text size inside fields
    "inputPaddingY": "10px",                                   // Height of fields (space above and below the text)
    "inputPaddingX": "14px",                                   // Space between the field box edge and the text
    "inputColor": "#1E1E1C",                                   // Text colour inside fields
    "textareaHeight": "82px",                                  // Height of the message box
    "buttonsGap": "26px",                                      // Space between the fields and the two buttons
    "buttonHeight": "40px",                                    // Button height
    "buttonSpacing": "12px",                                   // Space between the two buttons
    "buttonRadius": "5px",                                     // Button corner roundness
    "buttonTextSize": "15px",                                  // Button text size
    "atomFill": "#253A79",                                     // 'View on Atom.com' button colour
    "atomHoverFill": "#3A4E8C",                                // 'View on Atom.com' colour on hover
    "atomTextColor": "#F3F2EE",                                // 'View on Atom.com' text colour
    "sendFill": "#CAC8BAC1",                                   // 'Send inquiry' button fill (the last 2 digits make it see-through)
    "sendHoverFill": "#3A4E8CCE",                              // 'Send inquiry' fill on hover
    "sendTextColor": "#152860",                                // 'Send inquiry' text colour
    "sendHoverTextColor": "#E9E8E7",                           // 'Send inquiry' text colour on hover
    "sendBorder": { "style": "solid", "width": "0.5px", "color": "#253A79A7" },// 'Send inquiry' outline   [style: solid / dotted / dashed / none]
    "sendSheen": 0.14,                                         // Strength of the light gradient on 'Send inquiry' (same light direction as the buttons below)
    "sendEdge": 0.26,                                          // Strength of the thin highlight along its lit edge
    "sendGlowColor": "#8C8B84",                                // Colour of the soft shadow under 'Send inquiry' (on hover it takes the hover fill colour)
    "sendGlow": 0.055,                                         // Strength of that shadow
    "sendGlowBlur": "4px",                                     // Softness of that shadow
    "sendGlowY": "4px",                                        // How far below the button it sits
    "sendGlowHover": 0.08,                                     // Extra shadow strength on hover
    "aboutPaddingTop": "42px",                                 // Space above 'About the domain'
    "aboutPaddingBottom": "40px",                              // Space under the overview
    "aboutLabelGap": "20px",                                   // Space between that label and the text
    "aboutSize": "16.5px",                                     // Overview text size
    "aboutWeight": 400,                                        // Overview boldness
    "aboutLineHeight": 1.55,                                   // Overview line spacing
    "aboutColor": "#1E1E1C",                                   // Overview colour
    "aboutWidth": "557px",                                     // Width of the overview text
    "aboutParagraphGap": "18px",                               // Space between overview paragraphs
    "secondLabelGap": "22px",                                  // Extra space above the 'Ideal for' label, on top of the paragraph gap (also used on phones)
    "aboutBackground": "#F5F5F1",                              // Background of the overview and the 'More from the collection' heading
    "moreHeadPaddingTop": "44px",                              // Space above 'More from the collection'
    "moreHeadPaddingBottom": "16px",                           // Space between 'More from the collection' and the line under it
    "overviewShadowColor": "#72726E",                          // Colour of the soft shade rising from the collection row into the overview
    "overviewShadow": 0.03,                                    // Strength of that shade (0 = none)
    "overviewShadowReach": "62px",                             // How far up into the overview it reaches
    "moreSize": "10.5px",                                      // 'More from the collection' / 'Back to portfolio' text size
    "moreSpacing": ".11em",                                    // Their letter spacing
    "moreColor": "#3A3938",                                    // Their colour
    "moreHoverColor": "#3A4E8C",                               // Their colour on hover
    "moreArrowColor": "#9A9892",                               // Colour of the little arrow next to 'More from the collection'
    "relatedColumns": 4,                                       // How many related domains sit in a row (phones always show 3)
    "relatedLine": { "style": "dotted", "width": "1px", "color": "#C6C6B79E" },// Line under 'More from the collection'   [style: solid / dotted / dashed / none]
    "relatedBackground": "#F3F2EE",                            // Background of the related row
    "relatedPaddingTop": "22px",                               // Space above the related tiles
    "relatedPaddingBottom": "22px",                            // Space under the related tiles
    "relatedSidePadding": "18px",                              // Space left and right of the related tiles
    "relatedTileGap": "14px",                                  // Space between related tiles
    "relatedTileBackground": "#F3F2EE",                        // Related tile colour
    "relatedTileBorder": { "style": "solid", "width": "0.5px", "color": "#F3F2EE" },// Related tile outline   [style: solid / dotted / dashed / none]
    "relatedTileRadius": "4px",                                // Related tile corner roundness
    "relatedHoverContrast": 0.82,                              // Logo contrast on hover (1 = full colour, lower = softer)
    "relatedHoverBrightness": 1.15,                            // Logo brightness on hover (1 = as is, higher = lighter)
    "relatedCellPadding": "14px",                              // Space inside each related tile, above the logo and at the sides
    "relatedTopTrim": "-26px",                                 // Less space above the related logos (negative = less; the empty space in the logo is cropped, logos keep their size)
    "relatedLogoAreaPadding": "6% 12% 3%",                     // Space around the logo in a related cell: top, left+right, bottom
    "relatedLogoScale": 1.2,                                   // MASTER: resize the related logos (1 = as set in gallery-desktop.json)
    "relatedLogoX": "0%",                                      // MASTER: move the related logos right (+) or left (-)
    "relatedLogoY": "0%",                                      // MASTER: move the related logos down (+) or up (-)
    "relatedNameSize": "14px",                                 // Related domain name text size
    "relatedNamePadding": "9px 1px 10px",                      // Space around the related domain name: top, sides, bottom (more top = name lower, more bottom = name higher)
    "relatedNameColor": "#1A1A18",                             // Related domain name colour
    "relatedExtColor": "#9A9892",                              // Colour of .com / .si
    // depth: soft shadow, light and glow (a strength of 0 switches it off)
    "cardShadowColor": "#253A79",                              // Colour of the soft shadow the acquisition card casts into the viewer and the overview
    "cardShadowUp": 0.08,                                      // Strength of that shadow above the card (0 = none, 0.08 = 8%)
    "cardShadowDown": 0.08,                                    // Strength of that shadow below the card
    "cardShadowBlur": "25px",                                  // Softness of that shadow
    "cardShadowDistance": "3px",                               // How far it reaches up and down
    "cardShadowSpread": "-11px",                               // Pulls the shadow in from the sides (more negative = narrower)
    "cardSheenColor": "#DDDDD2",                               // Colour of the soft radial light/shade across the acquisition card
    "cardSheenStrength": 0.45,                                 // Its strength (0 = none)
    "cardSheenSize": "132%",                                   // Its size
    "cardSheenX": "11%",                                       // Where its centre sits, left (0%) to right (100%)
    "cardSheenY": "71%",                                       // Where its centre sits, top (0%) to bottom (100%)
    "buttonLightAngle": 180,                                   // Direction of the light on the buttons: 180 = from above, 225 = top right, 135 = top left (also the contact page button)
    "buttonSheen": 0.12,                                       // Strength of the light gradient on the buttons (0 = flat; also the contact page button)
    "buttonEdge": 0.18,                                        // Strength of the thin highlight along the lit edge of the buttons
    "buttonGlow": 0.09,                                        // Strength of the soft glow under each button, in the button's own colour
    "buttonGlowBlur": "4px",                                   // Softness of that glow
    "buttonGlowY": "4px",                                      // How far below the button the glow sits
    "buttonGlowHover": 0.08,                                   // Extra glow strength on hover
    "viewerSpotlight": 0.21,                                   // Strength of the soft light behind the logo in the viewer (0 = none)
    "viewerSpotlightWidth": "460px",                           // Width of that light
    "viewerSpotlightHeight": "180px",                          // Height of that light
    "viewerSpotlightY": "45%"                                  // Its height position, top (0%) to bottom (100%)
  },

  // ──────────────────────────────────────────────────────────────────────
  // CONTACT PAGE
  // The inquiry form page.
  // ──────────────────────────────────────────────────────────────────────
  "contact": {
    "titleSize": "35px",                                       // Page title size
    "titleWeight": 600,                                        // Page title boldness
    "titleColor": "#1A1A18",                                   // Page title colour
    "titlePaddingTop": "40px",                                 // Space above the title
    "titlePaddingBottom": "32px",                              // Space under the title
    "formPaddingTop": "44px",                                  // Space between title line and the intro text
    "formWidth": "505px",                                      // Width of the intro text and form
    "introSize": "16.5px",                                     // Intro text size
    "introWeight": 300,                                        // Intro boldness
    "introLineHeight": 1.55,                                   // Intro line spacing
    "introColor": "#1E1E1C",                                   // Intro colour
    "introGap": "36px",                                        // Space between intro and the form
    "fieldGap": "15px",                                        // Space between fields
    "fieldLine": { "style": "dotted", "width": "1px", "color": "#B3B2A8" }, // Line under each field   [style: solid / dotted / dashed / none]
    "inputSize": "15px",                                       // Text size inside fields
    "inputPaddingTop": "10px",                                 // Space above the text in a field
    "inputPaddingBottom": "16px",                              // Space under the text in a field
    "inputColor": "#1E1E1C",                                   // Text colour inside fields
    "textareaHeight": "96px",                                  // Height of the message box
    "buttonGap": "20px",                                       // Space between the fields and the button
    "buttonHeight": "40px",                                    // Button height
    "buttonPaddingX": "26px",                                  // Button width (space left and right of the text)
    "buttonRadius": "5px",                                     // Button corner roundness
    "buttonTextSize": "15px",                                  // Button text size
    "buttonTextColor": "#F3F2EE",                              // Button text colour
    "buttonFill": "#536FB0",                                   // Button colour
    "buttonHoverFill": "#44609E",                              // Button colour on hover
    "successTitleSize": "24px",                                // 'Message received' size
    "errorColor": "#8A2C1F"                                    // Colour of the error message
  }
}
